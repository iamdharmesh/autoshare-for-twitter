<?xml version="1.0"?>
<ruleset name="10up-autoshare">
	<description>Extension of the WordPress standard</description>
	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase" />
		<exclude name="WordPress.Files.FileName.InvalidClassFileName" />
		<exclude name="Generic.Arrays.DisallowShortArraySyntax.Found" />
		<exclude name="Universal.Arrays.DisallowShortArraySyntax.Found" />
		<exclude name="Universal.UseStatements.NoUselessAliases.Found" />
		<exclude name="Squiz.Functions.MultiLineFunctionDeclaration.SpaceAfterFunction" />
		<exclude name="PSR12.Files.FileHeader.IncorrectOrder" />
		<exclude name="Universal.UseStatements.NoLeadingBackslash.LeadingBackslashFound" />
		<exclude name="PSR2.Classes.ClassDeclaration.CloseBraceAfterBody" />
		<exclude name="PSR2.Methods.FunctionClosingBrace.SpacingBeforeClose" />
	</rule>
	<file>.</file>
	<exclude-pattern>node_modules</exclude-pattern>
	<exclude-pattern>vendor</exclude-pattern>
</ruleset>
